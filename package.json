{
  "name": "e-commerce-admin",
  "version": "1.0.0",
  "description": "E-Commerce Admin Dashboard with frontend and backend",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"nodemon server/server.js\" \"npm run start-frontend\"",
    "start-frontend": "cd frontend && npm start",
    "build": "cd frontend && npm install && npm run build",
    "test-frontend": "cd frontend && npm test",
    "eject-frontend": "cd frontend && npm run eject"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  }
}
